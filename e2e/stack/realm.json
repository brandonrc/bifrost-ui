{
  "realm": "bifrost-e2e",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "groups": [
    {
      "name": "bifrost-admins",
      "path": "/bifrost-admins"
    },
    {
      "name": "team-a",
      "path": "/team-a"
    },
    {
      "name": "team-b",
      "path": "/team-b"
    }
  ],
  "clients": [
    {
      "clientId": "bifrost-ui-spa",
      "name": "Bifrost dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5180/*",
        "http://localhost:5180/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5180",
        "http://localhost:5180"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5180/*##http://localhost:5180/*"
      },
      "protocolMappers": [
        {
          "name": "bifrost-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bifrost-ui-spa",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "e2e-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "e2e-admin@example.test",
      "firstName": "E2E",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "e2e-admin-password",
          "temporary": false
        }
      ],
      "groups": [
        "/bifrost-admins"
      ]
    },
    {
      "username": "e2e-alice",
      "enabled": true,
      "emailVerified": true,
      "email": "e2e-alice@example.test",
      "firstName": "Alice",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "e2e-alice-password",
          "temporary": false
        }
      ],
      "groups": [
        "/team-a"
      ]
    }
  ]
}
